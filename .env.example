# ==============================================================================
# ARZI — CIVIC RTI & STATUTORY LEGAL INTELLIGENCE DESK
# Environment Variables Configuration (Vercel & Notion Track)
# ==============================================================================

# --- Core Server Settings ---
FLASK_ENV=production
DEBUG=false
SECRET_KEY=arzi-civic-rti-secret-key-2026-prod-secure
PORT=5000

# --- Notion API Integration (Notion Track) ---
# Create an internal integration token at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_internal_integration_token_here

# 32-character hexadecimal Database IDs (extracted from Notion Database URLs)
NOTION_CASES_DATABASE_ID=your_32_hex_cases_database_id_here
NOTION_RUN_LOG_DATABASE_ID=your_32_hex_run_log_database_id_here

# Optional: Parent Page ID for automatic 1-click database provisioning
NOTION_PARENT_PAGE_ID=your_32_hex_parent_page_id_here
NOTION_WORKSPACE_NAME=ARZI Civic Legal Intelligence Desk

# Poller Sync Interval (seconds)
AUTO_SYNC_INTERVAL_SEC=10

# --- GitHub Repository Binding & Integrity ---
GITHUB_REPO_URL=https://api.github.com/repos/shivanshu23625/Arzi
GITHUB_REPO_CHECK_ENABLED=true